# base .v2d file generated by oms2v2d version 0.5 operating on file bb271b.oms

vex = bd247c3.vex.obs

antennas = BR, FD, HN, KP, LA, MK, NL, OV, PT, SC

# original window started 02:18:00 (mjdStart 59675.09583333, mjdStop
# 59675.09653444 = 60.6s) but not all antennas are on source at the very
# start - a short window there yields only 4 active datastreams. Start
# +20s instead. 15s of data = 260s wall on the RTX 2070 desktop; 4s
# keeps nsys runs around a minute.
mjdStart = 59675.09606481
mjdStop  = 59675.09623843

SETUP default
{
  tInt = 2.000
  nChan = 64
  nFFTChan = 128
  doPolar = True
  # 25 ms needs ~6.9 GB device memory; 20 ms (~5.8 GB) fits the RTX 2070's
  # 8 GB and is the benchmark config. nsys/CUPTI tracing needs extra VRAM
  # on top, so use 10 ms (~2.9 GB) when profiling.
  subintNS = 20000000
}

RULE default { setup = default }

# without these vex2difx writes no .threads file and mpifxcorr's config
# parsing derails (threads<-calc, calc<-im); 1 core rank, 10 threads
nCore = 1
nThread = 10

ANTENNA BR
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA FD
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA HN
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA KP
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA LA
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA MK
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA NL
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA OV
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA PT
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
ANTENNA SC
{
  source = fake
  format = VDIF/8032/2
  phaseCalInt = 0
}
